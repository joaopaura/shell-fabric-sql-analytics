	column is_latest_run = VAR t = FILTER ( ALL ( vw_pipeline_runs[step], vw_pipeline_runs[started_at], vw_pipeline_runs[pipeline_run_id] ), vw_pipeline_runs[step] = "dq" ) VAR lastRun = CONCATENATEX ( TOPN ( 1, t, vw_pipeline_runs[started_at], DESC ), vw_pipeline_runs[pipeline_run_id] ) RETURN vw_dq_results[pipeline_run_id] = lastRun
